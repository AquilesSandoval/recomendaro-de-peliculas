# ============================================================
# CineExpert — Variables de entorno
# Copia este archivo: cp .env.example .env
# Luego rellena los valores con tus credenciales
# ============================================================

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Supabase — Dashboard > Project Settings > Database > Connection string (URI)
# Formato: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=

# Servidor interno (no cambiar en local)
PROLOG_HOST=localhost
PROLOG_PORT=8081
PORT=3001
NODE_ENV=development

# Frontend Vite
VITE_API_URL=http://localhost:3001
